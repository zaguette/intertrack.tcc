NODE_ENV=development
PORT=3000
# URL única para runtime e migrations; codifique caracteres especiais da senha.
DATABASE_URL=mysql://USUARIO:SENHA@HOST:3306/BANCO
# TLS do runtime conforme provedor. CA opcional em PEM.
DATABASE_SSL=false
DATABASE_SSL_CA=
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
# Opcionais, apenas na criação do primeiro administrador pelo seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
